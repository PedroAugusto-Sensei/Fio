DATABASE_URL=postgres://fio:fio@localhost:5433/fio
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Entrada de e-mail. A leitura e sempre da caixa da empresa: nao existe entrada manual.
# Todo e-mail lido vira um "e-mail recebido"; um humano decide quais viram chamado.
# Os tres modos de instalacao sao SO configuracao, nao caminhos de codigo diferentes:
#   pasta observada (padrao em producao):  IMAP_FOLDER=Demandas
#   caixa inteira (demonstracao):          IMAP_FOLDER=INBOX
#   encaminhamento automatico:             o servidor da empresa reencaminha para esta
#     caixa; o remetente real sai do From original ou do Reply-To, nunca do envelope.
#
# NENHUMA CREDENCIAL ENTRA NESTE ARQUIVO. IMAP_PASSWORD so existe em backend/.env,
# que esta no .gitignore. No Gmail e a senha de app de 16 caracteres, SEM espacos.
IMAP_HOST=imap.suaempresa.com.br
IMAP_PORT=993
IMAP_USER=atendimento@suaempresa.com.br
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_TIMEOUT=30

# Anexo maior que isso e recusado e registrado no log; o e-mail entra do mesmo jeito.
ANEXO_MAX_BYTES=10485760
